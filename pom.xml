<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.esl.etl</groupId>
    <artifactId>etl-dataexport-v2</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ETL Data Export V2</name>
    <description>Extracao em sombra de Coletas e Fretes via Data Export.</description>

    <properties>
        <project.build.outputTimestamp>2026-09-13T00:00:00Z</project.build.outputTimestamp>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jackson.version>2.18.11</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.16</logback.version>
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <jacoco.version>0.8.15</jacoco.version>
        <spotless.version>3.10.0</spotless.version>
        <google.java.format.version>1.24.0</google.java.format.version>
        <dependency.check.version>12.2.0</dependency.check.version>
        <dependency.vulnerability.failBuildOnCVSS>0.0</dependency.vulnerability.failBuildOnCVSS>
        <failBuildOnCVSS>${dependency.vulnerability.failBuildOnCVSS}</failBuildOnCVSS>
        <dependency.vulnerability.policy.sha256>83c8698663f33b0e79ac987d72c7853fb59b12af42f31b07d1809377a454e056</dependency.vulnerability.policy.sha256>
        <flyway.version>9.22.3</flyway.version>
        <mssql.jdbc.version>12.8.2.jre11</mssql.jdbc.version>
        <mssql.jdbc.auth.x64.version>12.8.2.x64</mssql.jdbc.auth.x64.version>
        <contract.tests.enabled>false</contract.tests.enabled>
        <shadow.local.integration.enabled>false</shadow.local.integration.enabled>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>${mssql.jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>etl-dataexport-v2</finalName>
        <pluginManagement>
            <plugins>
                <!-- O Maven/CI continua executando Checkstyle; esta regra apenas evita que o
                     importador m2e da IDE tente executar o goal durante o build incremental. -->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-checkstyle-plugin</artifactId>
                                        <versionRange>[3.4.0,)</versionRange>
                                        <goals>
                                            <goal>check</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore/>
                                    </action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-build-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,18)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                </requireMavenVersion>
                                <requireProperty>
                                    <property>dependency.vulnerability.failBuildOnCVSS</property>
                                    <regex>^0(?:\.0+)?$</regex>
                                    <regexMessage>The versioned dependency vulnerability threshold must remain 0.0.</regexMessage>
                                </requireProperty>
                                <requireProperty>
                                    <property>failBuildOnCVSS</property>
                                    <regex>^0(?:\.0+)?$</regex>
                                    <regexMessage>An ungoverned dependency vulnerability threshold override is forbidden.</regexMessage>
                                </requireProperty>
                                <requireProperty>
                                    <property>dependency.vulnerability.policy.sha256</property>
                                    <regex>^83c8698663f33b0e79ac987d72c7853fb59b12af42f31b07d1809377a454e056$</regex>
                                    <regexMessage>The dependency vulnerability policy fingerprint must match the versioned catalog.</regexMessage>
                                </requireProperty>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>UTF-8</encoding>
                    <parameters>true</parameters>
                    <showWarnings>true</showWarnings>
                    <failOnWarning>true</failOnWarning>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google.java.format.version}</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>verify-format</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>check-style</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <configLocation>${project.basedir}/config/checkstyle.xml</configLocation>
                            <includeTestSourceDirectory>true</includeTestSourceDirectory>
                            <outputFileFormat>xml</outputFileFormat>
                            <failsOnError>true</failsOnError>
                            <consoleOutput>true</consoleOutput>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <argLine>${argLine} -Dfile.encoding=UTF-8</argLine>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-package-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>br.com.esl.etl.v2.plataforma.configuracao</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>br.com.esl.etl.v2.plataforma.fonte.dataexport</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.65</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>br.com.esl.etl.v2.plataforma.persistencia.sombra</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>br.com.esl.etl.v2.bootstrap.Main</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>package-runtime-libraries</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeTypes>jar</includeTypes>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>contract-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <systemPropertyVariables>
                                <contract.tests.enabled>${contract.tests.enabled}</contract.tests.enabled>
                                <contract.tests.profile.active>true</contract.tests.profile.active>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <id>contract-integration-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>shadow-local-integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copy-mssql-jdbc-auth-x64</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>com.microsoft.sqlserver</groupId>
                                            <artifactId>mssql-jdbc_auth</artifactId>
                                            <version>${mssql.jdbc.auth.x64.version}</version>
                                            <type>dll</type>
                                            <outputDirectory>${project.build.directory}/native</outputDirectory>
                                            <destFileName>mssql-jdbc_auth-${mssql.jdbc.auth.x64.version}.dll</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <includes>
                                <include>**/ShadowAuditLocalIntegrationIT.java</include>
                                <include>**/ColetasTemporalLocalIntegrationIT.java</include>
                                <include>**/RelationalLaboratory*IT.java</include>
                                <include>**/ExpansionLaboratory*IT.java</include>
                                <include>**/AnalyticLaboratory*IT.java</include>
                                <include>**/AnalyticExpansionCaptureIT.java</include>
                                <include>**/AnalyticFixtureBindingsIT.java</include>
                                <include>**/AnalyticManifestCompositionsIT.java</include>
                                <include>**/AnalyticRasterCivilTimeIT.java</include>
                                <include>**/AnalyticScenarioIsolationIT.java</include>
                                <include>**/AnalyticScenarioPlanIT.java</include>
                                <include>**/AnalyticScenarioRuntimeIT.java</include>
                                <include>**/Integral*IT.java</include>
                                <include>**/Qualification*IT.java</include>
                            </includes>
                            <argLine>${argLine} -Dfile.encoding=UTF-8 -Djava.library.path=${project.build.directory}/native</argLine>
                            <systemPropertyVariables>
                                <shadow.local.integration.enabled>${shadow.local.integration.enabled}</shadow.local.integration.enabled>
                                <shadow.local.integration.profile.active>true</shadow.local.integration.profile.active>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <id>shadow-local-integration-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>runtime-recovery-local-integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copy-runtime-recovery-mssql-jdbc-auth-x64</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>com.microsoft.sqlserver</groupId>
                                            <artifactId>mssql-jdbc_auth</artifactId>
                                            <version>${mssql.jdbc.auth.x64.version}</version>
                                            <type>dll</type>
                                            <outputDirectory>${project.build.directory}/native</outputDirectory>
                                            <destFileName>mssql-jdbc_auth-${mssql.jdbc.auth.x64.version}.dll</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.3.1</version>
                        <configuration>
                            <includes>
                                <include>**/RuntimeRecoveryLocalIntegrationIT.java</include>
                            </includes>
                            <argLine>${argLine} -Dfile.encoding=UTF-8 -Djava.library.path=${project.build.directory}/native</argLine>
                            <systemPropertyVariables>
                                <runtime.recovery.local.integration.enabled>${runtime.recovery.local.integration.enabled}</runtime.recovery.local.integration.enabled>
                                <runtime.recovery.local.integration.profile.active>true</runtime.recovery.local.integration.profile.active>
                                <runtime.recovery.local.integration.manifest>${runtime.recovery.local.integration.manifest}</runtime.recovery.local.integration.manifest>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <id>runtime-recovery-local-integration-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>security-audit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency.check.version}</version>
                        <configuration>
                            <dataDirectory>${user.home}/.m2/dependency-check-data</dataDirectory>
                            <outputDirectory>${project.build.directory}/dependency-check</outputDirectory>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <failBuildOnCVSS>${failBuildOnCVSS}</failBuildOnCVSS>
                            <failOnError>true</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>dependency-vulnerability-audit</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>shadow-migrations-windows-auth</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-maven-plugin</artifactId>
                        <version>${flyway.version}</version>
                        <configuration>
                            <url>${env.V2_SHADOW_JDBC_URL}</url>
                            <locations>
                                <location>filesystem:${project.basedir}/database/migrations</location>
                            </locations>
                            <defaultSchema>ctl</defaultSchema>
                            <schemas>
                                <schema>ctl</schema>
                            </schemas>
                            <table>flyway_schema_history</table>
                            <createSchemas>true</createSchemas>
                            <baselineOnMigrate>false</baselineOnMigrate>
                            <cleanDisabled>true</cleanDisabled>
                            <mixed>false</mixed>
                            <outOfOrder>false</outOfOrder>
                            <validateOnMigrate>true</validateOnMigrate>
                            <validateMigrationNaming>true</validateMigrationNaming>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.flywaydb</groupId>
                                <artifactId>flyway-sqlserver</artifactId>
                                <version>${flyway.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>com.microsoft.sqlserver</groupId>
                                <artifactId>mssql-jdbc</artifactId>
                                <version>${mssql.jdbc.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
